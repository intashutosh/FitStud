# ==========================================
# 1. SPRING BOOT / JAVA (Maven & Gradle)
# ==========================================
**/target/
**/build/
**/.gradle/
**/out/

# Keep Maven/Gradle wrappers, ignore the jar
!**/mvn/wrapper/maven-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.jar

# Logs & Java crash dumps
*.log
hs_err_pid*
replay_pid*

# Spring Boot local configs & secrets (keep base application.properties/yml)
**/application-local.properties
**/application-local.yml
**/application-dev.properties
**/application-dev.yml
**/application-secret*.properties
**/application-secret*.yml

# ==========================================
# 2. REACT / NODE.JS (Vite / CRA / Next.js)
# ==========================================
**/node_modules/
**/.pnp
**/.pnp.js

# Production builds & caches
**/dist/
**/.next/
**/.vite/
**/.cache/
**/.eslintcache
*.tsbuildinfo

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# 3. POSTGRESQL & LOCAL DATA
# ==========================================
# Local Docker bind-mount volumes & DB data
**/postgres-data/
**/pgdata/
**/db-data/

# Database backups & dumps (keep schema.sql / data.sql migrations)
*.dump
*.sql.gz
*.bak
*.sqlite
*.sqlite3

# ==========================================
# 4. ENVIRONMENT & SECRETS
# ==========================================
.env
.env.*
!.env.example
!.env.template
**/*.pem
**/*.key

# ==========================================
# 5. IDEs & OS FILES
# ==========================================
# IntelliJ IDEA
**/.idea/
*.iws
*.iml
*.ipr

# VS Code
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/tasks.json
!**/.vscode/launch.json
!**/.vscode/extensions.json

# Eclipse / STS
**/.settings/
**/.classpath
**/.project
**/.factorypath

# macOS / Windows / Linux
.DS_Store
Thumbs.db
*~